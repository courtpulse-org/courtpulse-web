{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elements": {
      "import": "./dist/elements/index.js",
      "types": "./dist/elements/index.d.ts"
    },
    "./court": {
      "import": "./dist/court/index.js",
      "types": "./dist/court/index.d.ts"
    },
    "./hoc": {
      "import": "./dist/hoc/index.js",
      "types": "./dist/hoc/index.d.ts"
    },
    "./input": {
      "import": "./dist/input/index.js",
      "types": "./dist/input/index.d.ts"
    },
    "./icons": {
      "import": "./dist/icons/index.js",
      "types": "./dist/icons/index.d.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "build": "tsc",
    "gen:theme-typings": "chakra typegen ../../packages/theme/src/index.ts",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/utils": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/theme": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.31.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@chakra-ui/cli": "^3.21.0",
    "@chakra-ui/react": "^3.24.2",
    "@emotion/react": "^11.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.7.1"
  }
}
